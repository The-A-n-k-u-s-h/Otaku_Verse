# ==================================
# FLASK CONFIGURATION
# ==================================
SECRET_KEY=replace_with_a_long_random_secret
FLASK_ENV=development
FLASK_DEBUG=1

# ==================================
# DATABASE & STORAGE
# ==================================
WAIFU_DATABASE=instance/waifu_matching.sqlite3
WAIFU_JSON_PATH=instance/waifu_question_bank.json

# ==================================
# OPERATOR AUTHENTICATION & ACCESS
# ==================================
OPERATOR_USERNAME=Ankush
OPERATOR_PASSWORD=Ankush
OPERATOR_MASTER_PASSWORD=Ankush

OPERATOR_CODE_RECOMMENDATIONS=replace_with_unique_code_1
OPERATOR_CODE_QUIZ=replace_with_unique_code_2
OPERATOR_CODE_WAIFU=replace_with_unique_code_3
OPERATOR_CODE_HOT_TAKES=replace_with_unique_code_4
OPERATOR_CODE_DISCUSSIONS=replace_with_unique_code_5

# ==================================
# AI ORCHESTRATION CONFIGURATION
# ==================================
# Providers are tried from left to right. Missing/unconfigured providers are skipped.
AI_PROVIDER_ORDER=openai,gemini,groq,openrouter
AI_PROVIDER_TIMEOUT=45
AI_PROVIDER_RETRIES=1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Groq ---
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=OtakuVerse

# --- Custom AI Endpoint ---
CUSTOM_AI_API_KEY=
CUSTOM_AI_KEYS=
CUSTOM_AI_MODEL=
CUSTOM_BASE_URL=

